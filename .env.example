# Copy to .env.local for local overrides. Both variables are optional.

# Where `npm run dev` proxies /api. Docker Compose sets http://backend:8000.
VITE_API_PROXY_TARGET=http://localhost:8000

# Absolute API base, if you want to bypass the dev proxy entirely.
# Leave unset to use the proxied relative default, /api/v1.
# VITE_API_BASE_URL=http://localhost:8000/api/v1
